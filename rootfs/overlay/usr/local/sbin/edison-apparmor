#!/bin/sh
# Turn AppArmor on or off. The kernel has it built in but not enabled; this adds it to the
# kernel's list of security modules on the command line (U-Boot's extra_bootargs), from the
# next boot. The setting is kept on the config partition, so it survives reflashing.
#
#   edison-apparmor on | off | status
set -eu

LSM="lsm=landlock,lockdown,yama,loadpin,safesetid,ipe,bpf,apparmor"
SAVED=/var/lib/edison/extra_bootargs

active() { grep -qw apparmor /sys/kernel/security/lsm 2>/dev/null; }

# Set extra_bootargs (empty: unset) in U-Boot's environment and on the config partition.
set_args() {
    if [ -n "$1" ]; then
        fw_setenv extra_bootargs "$1"
        printf '%s\n' "$1" > "$SAVED"
    else
        fw_setenv extra_bootargs
        rm -f "$SAVED"
    fi
}

case "${1:-status}" in
    on|off)
        if [ "$(id -u)" != 0 ]; then
            echo "run as root: sudo edison-apparmor $1" >&2
            exit 1
        fi
        # An environment flashed before v0.2.9 builds the command line without extra_bootargs.
        if ! fw_printenv -n do_boot | grep -q extra_bootargs; then
            echo "U-Boot's environment is too old for this: do a full flash (uv run flash.py)" >&2
            exit 1
        fi
        current=$(fw_printenv -n extra_bootargs 2>/dev/null || true)
        # Keep any other extra arguments; replace only an lsm= list.
        others=$(printf '%s\n' "$current" | tr ' ' '\n' | grep -v '^lsm=' | grep -v '^$' | paste -sd' ' -)
        if [ "$1" = on ]; then
            set_args "${others:+$others }$LSM"
        else
            set_args "$others"
        fi
        if [ "$1" = on ] && ! active; then
            echo "AppArmor will be on from the next boot: sudo reboot"
        elif [ "$1" = off ] && active; then
            echo "AppArmor will be off from the next boot: sudo reboot"
        else
            echo "AppArmor is already $1."
        fi
        ;;
    status)
        if active; then echo "AppArmor: on"; else echo "AppArmor: off"; fi
        if command -v aa-status >/dev/null && active && [ "$(id -u)" = 0 ]; then
            aa-status --profiled 2>/dev/null | sed 's/$/ profiles loaded/'
        fi
        ;;
    *)
        echo "usage: edison-apparmor on|off|status" >&2
        exit 2
        ;;
esac
