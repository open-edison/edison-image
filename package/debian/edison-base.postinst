#!/bin/sh
set -e

if [ "$1" = configure ]; then
    # The udev rules give this group the GPIO, PWM, SPI and CPU latency devices.
    getent group gpio >/dev/null || groupadd --system gpio
    # Mount points (fstab) for the config, factory and boot partitions.
    mkdir -p /var/lib/edison /factory /boot/firmware
fi

#DEBHELPER#

exit 0
