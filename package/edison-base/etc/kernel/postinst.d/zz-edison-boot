#!/bin/sh
# Run by kernel packages after install and removal (postinst.d and postrm.d): put the newest
# installed kernel on the boot partition, where U-Boot loads it, keeping the one it replaces
# as vmlinuz.prev (U-Boot falls back to it if vmlinuz is missing or unreadable).
set -eu

BOOT=/boot/firmware

if ! mountpoint -q "$BOOT"; then
    # In an image build (a chroot) the boot partition is made separately.
    echo "edison-boot: $BOOT is not mounted; not updating the boot partition" >&2
    exit 0
fi

# Newest by version: the kernel packages install /boot/vmlinuz-<release>.
newest=$(find /boot -maxdepth 1 -name 'vmlinuz-*' | sort -V | tail -n 1)
if [ -z "$newest" ]; then
    echo "edison-boot: no kernel in /boot; leaving the boot partition alone" >&2
    exit 0
fi
if cmp -s "$newest" "$BOOT/vmlinuz"; then
    exit 0
fi

echo "edison-boot: installing ${newest#/boot/} on the boot partition"
cp "$newest" "$BOOT/vmlinuz.new"
sync
# A crash between these two renames leaves no vmlinuz; U-Boot then boots vmlinuz.prev.
if [ -f "$BOOT/vmlinuz" ]; then
    mv -f "$BOOT/vmlinuz" "$BOOT/vmlinuz.prev"
fi
mv "$BOOT/vmlinuz.new" "$BOOT/vmlinuz"
sync
# Debian's convention for "reboot to finish" (shown at login by some tools).
touch /run/reboot-required
